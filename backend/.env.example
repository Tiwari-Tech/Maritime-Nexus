# Maritime Nexus API Configuration
ENVIRONMENT=development
PROJECT_NAME="Maritime Nexus API"
VERSION="0.1.0"

# Database Configuration (Cloud SQL PostgreSQL)
DATABASE_NAME=maritime_nexus
DB_USER=postgres
DB_PASSWORD=your_db_password_here
CLOUD_SQL_CONNECTION_NAME=maritime-nexus:asia-south1:maritime-nexus-db

# Optional local host/port (defaults to 127.0.0.1:5432 for Cloud SQL Auth Proxy)
DB_HOST=127.0.0.1
DB_PORT=5432

# Ollama & Embedding Configuration (BGE-M3 default dimension is 1024)
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024

# RAG Configuration
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=200
RAG_DEFAULT_TOP_K=5
RAG_MAX_TOP_K=20

# Firebase Configuration
# FIREBASE_PROJECT_ID: your Google Cloud / Firebase project ID
FIREBASE_PROJECT_ID=maritime-nexus
# GOOGLE_APPLICATION_CREDENTIALS: absolute path to service-account JSON file (local dev only)
# Never commit the actual JSON file or its path with real content.
# On Cloud Run, leave this unset — the managed service account identity is used automatically.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account.json

# Google Cloud Storage Configuration
GCS_BUCKET_NAME=your-gcs-bucket-name
MAX_DOCUMENT_SIZE_MB=50
